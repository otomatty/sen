{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sen",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 毎日 3:17（日本時間）に古い同期ログ、期限切れセッション、7日より前の AI アシスタント利用回数を掃除する
  "triggers": { "crons": ["17 18 * * *"] },
  // SPA と静的ファイル（チュートリアル動画を含む）は Workers Static Assets で配信し、
  // /api/* と /.well-known/* は Worker を先に通す。
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sen-db",
      // Cloudflare 上に作成済みの D1（sen-db, APAC）。別のアカウントに出すときは `bun run cf:setup` で書き換わります。
      "database_id": "e90e08a4-48fe-4662-9a18-5433a62ecb78",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "WorkspaceRealtime" }]
  },
  // 招待メールの送信に使う（Cloudflare Email Service）。送信元のドメインを Email Sending に登録し、INVITE_EMAIL_FROM を設定したときだけ送る
  "send_email": [{ "name": "EMAIL" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceRealtime"] }]
}
