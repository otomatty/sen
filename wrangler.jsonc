{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sen",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 毎日 3:17（日本時間）に古い同期ログと期限切れセッションを掃除する
  "triggers": { "crons": ["17 18 * * *"] },
  // SPA と静的ファイル（チュートリアル動画を含む）は Workers Static Assets で配信し、
  // /api/* だけ Worker を先に通す。
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sen-db",
      // `npm run cf:setup` が自動で書き換えます（初回のみ）。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "WorkspaceRealtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceRealtime"] }]
}
